{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build driver",
      "type": "shell",
      "command": "make -C driver",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "clean driver",
      "type": "shell",
      "command": "make -C driver clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
